{
  "name": "@gridlock/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "GridLock's contracts as TypeScript types, generated from the Pydantic models in packages/contracts.",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "types": "./src/generated.d.ts",
  "exports": {
    ".": {
      "types": "./src/generated.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/generate.mjs",
    "lint": "prettier --check .",
    "test": "node scripts/generate.mjs --check && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
